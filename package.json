{
  "name": "dsh-context-compaction-optimizer",
  "version": "0.1.0",
  "description": "DSH plugin: mark messages as invalid so an operator annotation digest steers what a compaction checkpoint absorbs. Cache-preserving: appends after the cached prefix, never rewrites history.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "compaction",
    "context",
    "annotation",
    "summarization"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "author": "bigPaulSixSixSix",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigPaulSixSixSix/dsh-context-compaction-optimizer.git"
  },
  "homepage": "https://github.com/bigPaulSixSixSix/dsh-context-compaction-optimizer#readme",
  "bugs": {
    "url": "https://github.com/bigPaulSixSixSix/dsh-context-compaction-optimizer/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.ts",
    "measure": "node scripts/measure-cache.ts",
    "smoke": "node scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "bundle": "node scripts/build.mjs",
    "prepublishOnly": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-invariants": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-storage": "0.1.5-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.5-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "esbuild": "^0.28.2",
    "esbuild-wasm": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
